{
  "name": "DispatchRequest",
  "type": "object",
  "properties": {
    "voice_url": {
      "type": "string",
      "description": "URL to the recorded voice message"
    },
    "transcript": {
      "type": "string",
      "description": "AI-generated transcript of the voice message"
    },
    "status": {
      "type": "string",
      "enum": [
        "recording",
        "processing",
        "analyzing",
        "dispatching",
        "assigned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "recording",
      "description": "Current status of the dispatch request"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "AI-detected urgency level"
    },
    "category": {
      "type": "string",
      "enum": [
        "doctor",
        "nurse",
        "social_worker",
        "psychiatrist",
        "physical_therapist",
        "emergency",
        "general"
      ],
      "description": "Type of professional needed"
    },
    "assigned_professional_name": {
      "type": "string",
      "description": "Name of the assigned professional"
    },
    "assigned_professional_role": {
      "type": "string",
      "description": "Role of the assigned professional"
    },
    "estimated_response_time": {
      "type": "string",
      "description": "Estimated time for professional to respond"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes from AI analysis"
    }
  },
  "required": []
}
